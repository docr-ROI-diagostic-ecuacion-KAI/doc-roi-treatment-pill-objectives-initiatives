{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/render.js": {
      "includeFiles": "index.html"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/render.js"
    },
    {
      "src": "^/index\\.html$",
      "dest": "/api/render.js"
    },
    {
      "handle": "filesystem"
    }
  ]
}
